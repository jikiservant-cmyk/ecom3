# ============================================================
# Drum Palace — environment configuration
# Copy to .env.local for development. NEVER commit real values.
# ============================================================

# --- App ---
# The PUBLIC https origin of the deployment. Used to build the gateway return
# URL and the webhook-signature candidates, and as the only origin a checkout may
# redirect back to. Must be the real domain in production: with localhost here,
# card payments bounce to a dead URL and webhook signatures fail to match.
#   example: APP_URL="https://drumpalace.ug"
APP_URL="http://localhost:3000"

# --- Supabase ---
# Public project URL and ANON key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SERVICE ROLE key — server-side ONLY. Required in production for order writes,
# webhook processing, and admin reads. Never expose to the browser, never prefix
# with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- LivePay payment gateway (https://docs.livepay.me/) ---
# Server-side only. The app FAILS CLOSED when these are unset: payments are
# rejected instead of simulated.
# Collect-money credential (docs.livepay.me/request-money): a single API key
# sent as `Authorization: Bearer <API key>`. Server-side only.
LIVEPAY_API_KEY="YOUR_LIVEPAY_API_KEY"
# Not used by the documented LivePay API (kept for compatibility).
LIVEPAY_SECRET_KEY="YOUR_LIVEPAY_SECRET_KEY"
# Your LivePay account number, e.g. LP2305443309 (sent as "accountNumber").
LIVEPAY_MERCHANT_ID="YOUR_LIVEPAY_ACCOUNT_NUMBER"
# Webhook secret from the LivePay dashboard. Required: without it the webhook
# endpoint rejects every request (fail-closed).
LIVEPAY_WEBHOOK_SECRET="YOUR_LIVEPAY_WEBHOOK_SECRET"
# Card-collection credential (docs.livepay.me/card-collection): a dot-separated
# `keyId.secret` pair, sent as `Authorization: Bearer keyId.secret`. NOT
# interchangeable with the collect-money key. Leave unset to disable card
# payments; if set, card checkout is offered at checkout.
# Format is literally "keyId.secret" — the whole dotted pair, one value:
#   example: LIVEPAY_CARD_API_KEY="ck_live_9f3a.8b1c4d2e6f7a9051"
# Adding a space, or setting only the secret half, produces a 401 from LivePay.
LIVEPAY_CARD_API_KEY="YOUR_LIVEPAY_KEY_ID.YOUR_LIVEPAY_SECRET"
# Optionally a different account number for the card account.
LIVEPAY_CARD_MERCHANT_ID="YOUR_LIVEPAY_ACCOUNT_NUMBER"
# UGX per 1 USD used to turn a UGX order total into the USD amount LivePay's
# card product charges (it is USD-only). REQUIRED for card payments: without a
# positive rate, card checkout is refused rather than guessed. Update it when
# the rate moves; every charge records the rate it used.
LIVEPAY_USD_RATE_UGX="3800"
LIVEPAY_API_URL="https://livepay.me/api"

# --- Rate limiting ---
# Number of TRUSTED reverse proxies in front of the app. The client IP used for
# rate limiting is the Nth entry from the right of X-Forwarded-For; everything
# further left is attacker-controlled. Default 1 (a single platform proxy that
# appends the client address). If the chain is shorter than this value the
# header is ignored entirely rather than trusted.
TRUSTED_PROXY_HOPS="1"

# ============================================================
# Summary — what is REQUIRED, what is OPTIONAL
#
# REQUIRED for the store to work at all:
#   NEXT_PUBLIC_SUPABASE_URL          https://<project>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY     public anon key
#   SUPABASE_SERVICE_ROLE_KEY         server-only; without it checkout, webhooks,
#                                     refunds and the admin API return 503
#   APP_URL                           public https origin
#
# REQUIRED for Mobile Money:
#   LIVEPAY_API_KEY                   collect-money key (Bearer <key>)
#   LIVEPAY_MERCHANT_ID               your accountNumber, e.g. LP2305443309
#   LIVEPAY_WEBHOOK_SECRET            without it the webhook rejects ALL traffic,
#                                     so no order ever becomes paid
#
# REQUIRED for cards (skip if you only take MoMo + Cash on Delivery):
#   LIVEPAY_CARD_API_KEY              "keyId.secret"
#   LIVEPAY_USD_RATE_UGX              UGX per 1 USD; card checkout answers 422
#                                     rather than guessing a rate
#   LIVEPAY_CARD_MERCHANT_ID          optional; defaults to LIVEPAY_MERCHANT_ID
#
# OPTIONAL (safe defaults):
#   LIVEPAY_API_URL                   default https://livepay.me/api; must be a
#                                     livepay.me host
#   TRUSTED_PROXY_HOPS                default 1. MUST match your host's proxy
#                                     count or per-IP rate limits are spoofable
#
# NOT USED — do not bother setting it:
#   LIVEPAY_SECRET_KEY                the documented API has no such credential;
#                                     the webhook HMAC uses LIVEPAY_WEBHOOK_SECRET
#
# Never put a secret in a NEXT_PUBLIC_* variable: anything with that prefix is
# compiled into the browser bundle.
# ============================================================
